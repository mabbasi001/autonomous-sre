# Copy to .env and fill in. The .env file is gitignored - never commit it.
# Real environment variables take precedence over this file.

# runtime role: append-only on audit_logs. Migrations use the owning role.
SRE_DATABASE_URL=postgresql+psycopg://sre_app:sre_app@localhost:5432/sre
SRE_MIGRATION_DATABASE_URL=postgresql+psycopg://sre:sre@localhost:5432/sre
SRE_ENVIRONMENT=development
SRE_LOG_LEVEL=INFO

# Slack incoming webhook. Empty = notifications disabled.
SRE_SLACK_WEBHOOK_URL=

# Operator auth. Modes are selected in this order:
#   1. Entra ID OIDC  — set SRE_OIDC_TENANT_ID (+ CLIENT_ID).
#   2. Local accounts — leave OIDC empty, set SRE_AUTH_SECRET. Create
#      accounts with `python -m app.cli create-user`.
#   3. Neither — dev fallback (synthetic admin) in development; 401 else.
SRE_OIDC_TENANT_ID=
SRE_OIDC_CLIENT_ID=

# Signing key for local-account session tokens (mode 2 above). Generate
# with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SRE_AUTH_SECRET=

# Anthropic API key for incident diagnosis. Empty = incidents go to
# manual triage instead of AI investigation.
ANTHROPIC_API_KEY=

