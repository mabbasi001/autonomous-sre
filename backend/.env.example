# Copy to .env and fill in. The .env file is gitignored - never commit it.
# Real environment variables take precedence over this file.

SRE_DATABASE_URL=postgresql+psycopg://sre:sre@localhost:5432/sre
SRE_ENVIRONMENT=development
SRE_LOG_LEVEL=INFO

# Slack incoming webhook. Empty = notifications disabled.
SRE_SLACK_WEBHOOK_URL=
